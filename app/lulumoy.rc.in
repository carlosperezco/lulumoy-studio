// Recursos del ejecutable de Windows: icono y datos de versión que muestra
// el Explorador en Propiedades > Detalles. Archivo generado por CMake a partir
// de app/lulumoy.rc.in; no editar la copia de build/.
#include <winver.h>

IDI_ICON1 ICON "@LULUMOY_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DonatellaTech"
            VALUE "FileDescription", "Lulumoy Studio"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "lulumoy"
            VALUE "LegalCopyright", "Copyright (c) 2026 Carlos N. Perez-Montenegro (DonatellaTech). MIT License."
            VALUE "OriginalFilename", "lulumoy.exe"
            VALUE "ProductName", "Lulumoy Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
